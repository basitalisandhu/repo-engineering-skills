{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.ada-example/weather-mcp",
  "title": "Weather",
  "description": "Forecasts and weather alerts for a city, from a public weather API",
  "version": "1.4.0",
  "repository": {
    "url": "https://github.com/ada-example/weather-mcp",
    "source": "github"
  },
  "websiteUrl": "https://weather.example.com/docs",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@ada-example/weather-mcp",
      "version": "1.4.0",
      "transport": {
        "type": "stdio"
      }
    },
    {
      "registryType": "pypi",
      "identifier": "weather-mcp",
      "version": "1.4.0",
      "transport": {
        "type": "stdio"
      }
    },
    {
      "registryType": "oci",
      "identifier": "ghcr.io/ada-example/weather-mcp:1.4.0",
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://weather.example.com/mcp"
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "tool": "example-ci",
      "version": "2.0.0"
    }
  }
}
